# ============================================
# FRONTEND - Variables de Entorno
# ============================================

# ============================================
# API
# ============================================
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# ============================================
# APLICACIÓN
# ============================================
VITE_APP_NAME=Sistema CAD
VITE_APP_VERSION=1.0.0

# ============================================
# MAPAS GIS
# ============================================
# Leaflet / OpenStreetMap (gratis)
VITE_MAP_PROVIDER=openstreetmap
VITE_MAP_CENTER_LAT=19.4326
VITE_MAP_CENTER_LNG=-99.1332
VITE_MAP_DEFAULT_ZOOM=13

# Opcional: Mapbox (requiere token)
# VITE_MAPBOX_TOKEN=tu_token_de_mapbox_aqui
# VITE_MAP_PROVIDER=mapbox

# ============================================
# CONFIGURACIÓN SISTEMA CAD
# ============================================
# Tiempo de actualización de datos en tiempo real (ms)
VITE_REAL_TIME_UPDATE_INTERVAL=5000

# Timeout de inactividad para sesión (minutos)
VITE_SESSION_TIMEOUT=30

# Mostrar versión en interfaz
VITE_SHOW_VERSION=true

# Habilitar modo debug
VITE_DEBUG=false
