# ============================================
# BACKEND - Variables de Entorno
# ============================================

# ============================================
# SERVIDOR
# ============================================
NODE_ENV=development
PORT=4000
HOST=localhost

# ============================================
# BASE DE DATOS - PostgreSQL
# ============================================
DATABASE_URL="postgresql://cad_user:cad_password_2024@localhost:5432/cad_database?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cad_redis_2024
REDIS_DB=0

# ============================================
# AUTENTICACIÓN JWT
# ============================================
JWT_SECRET=tu_secreto_super_seguro_cambialo_en_produccion
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=tu_refresh_secret_super_seguro
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# SEGURIDAD
# ============================================
BCRYPT_ROUNDS=12
SESSION_SECRET=tu_session_secret_super_seguro
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# SOCKET.IO
# ============================================
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ============================================
# UPLOADS
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ============================================
# CONFIGURACIÓN SISTEMA CAD
# ============================================
# Tiempo de sesión inactiva (minutos)
SESSION_TIMEOUT=30

# Intentos máximos de login
MAX_LOGIN_ATTEMPTS=3

# Tiempo de bloqueo después de intentos fallidos (minutos)
LOCK_TIME=5

# Código de centro/municipio por defecto
DEFAULT_MUNICIPALITY_CODE=TOLUCA

# Prefijo de folios
FOLIO_PREFIX=EDOMEX
