// ============================================
// ESQUEMA DE BASE DE DATOS - SISTEMA CAD
// Sistema de Despacho Asistido por Computadora
// ============================================
// IMPORTANTE: Todos los nombres en ESPAÑOL
// Normalización: Mínimo 3FN
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MÓDULO: USUARIOS Y AUTENTICACIÓN
// ============================================

/// Tabla de usuarios del sistema
/// Almacena información de operadores, despachadores, supervisores y administradores
model Usuario {
  id                     String    @id @default(uuid())
  nombreUsuario          String    @unique @map("nombre_usuario")
  contrasena             String
  correoElectronico      String?   @unique @map("correo_electronico")
  nombre                 String
  apellidoPaterno        String    @map("apellido_paterno")
  apellidoMaterno        String?   @map("apellido_materno")
  telefono               String?

  // Relación con perfil
  perfilId               String    @map("perfil_id")
  perfil                 Perfil    @relation(fields: [perfilId], references: [id])

  // Estado y control
  estaActivo             Boolean   @default(true) @map("esta_activo")
  estaBloqueado          Boolean   @default(false) @map("esta_bloqueado")
  intentosLogin          Int       @default(0) @map("intentos_login")
  ultimoAcceso           DateTime? @map("ultimo_acceso")

  // Configuración telefónica
  accesoTelefonicoHabilitado Boolean @default(false) @map("acceso_telefonico_habilitado")
  extension              String?   @unique
  extensionActiva        Boolean   @default(false) @map("extension_activa")

  // Auditoría
  creadoEn               DateTime  @default(now()) @map("creado_en")
  actualizadoEn          DateTime  @updatedAt @map("actualizado_en")
  creadoPor              String?   @map("creado_por")

  // Relaciones
  municipios             UsuarioMunicipio[]
  corporaciones          UsuarioCorporacion[]
  incidentes             Incidente[]
  registrosAuditoria     RegistroAuditoria[] @relation("UsuarioAuditoria")
  ausencias              Ausencia[]
  llamadas               LlamadaTelefonica[] @relation("OperadorLlamada")

  @@map("usuarios")
}

/// Tabla de perfiles/roles del sistema
/// Define los diferentes tipos de usuarios y sus permisos
model Perfil {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  permisos    Json     /// Estructura JSON con permisos específicos
  estaActivo  Boolean  @default(true) @map("esta_activo")
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuarios    Usuario[]

  @@map("perfiles")
}

// ============================================
// MÓDULO: CATÁLOGOS GEOGRÁFICOS
// ============================================

/// Catálogo de municipios
/// Almacena los municipios del Estado de México
model Municipio {
  id          String   @id @default(uuid())
  nombre      String   @unique
  estado      String   @default("Estado de México")
  estaActivo  Boolean  @default(true) @map("esta_activo")
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  colonias    Colonia[]
  calles      Calle[]
  incidentes  Incidente[]
  usuarios    UsuarioMunicipio[]

  @@map("municipios")
}

/// Catálogo de colonias
/// Almacena colonias y asentamientos por municipio
model Colonia {
  id            String    @id @default(uuid())
  nombre        String
  codigoPostal  String    @map("codigo_postal")
  municipioId   String    @map("municipio_id")
  municipio     Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)

  /// Coordenadas geográficas del centroide de la colonia
  latitud       Float?
  longitud      Float?

  estaActivo    Boolean   @default(true) @map("esta_activo")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  incidentes    Incidente[]

  @@unique([nombre, municipioId])
  @@map("colonias")
}

/// Catálogo de calles
/// Almacena el directorio de calles por municipio
model Calle {
  id            String    @id @default(uuid())
  nombre        String
  municipioId   String    @map("municipio_id")
  municipio     Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  estaActivo    Boolean   @default(true) @map("esta_activo")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  @@index([nombre, municipioId])
  @@map("calles")
}

// ============================================
// MÓDULO: TIPOS DE INCIDENTES
// ============================================

/// Catálogo jerárquico de tipos de incidentes
/// Estructura: Categoría > Subcategoría > Tipo Específico
model TipoIncidente {
  id                     String          @id @default(uuid())
  codigo                 String          @unique
  nombre                 String

  /// Relación jerárquica
  padreId                String?         @map("padre_id")
  padre                  TipoIncidente?  @relation("JerarquiaTipos", fields: [padreId], references: [id])
  hijos                  TipoIncidente[] @relation("JerarquiaTipos")

  /// Configuración del tipo
  categoria              String
  prioridadPorDefecto    String          @map("prioridad_por_defecto")
  tiempoRespuestaEsperado Int            @map("tiempo_respuesta_esperado") /// En minutos
  requiereCuestionario   Boolean         @default(false) @map("requiere_cuestionario")
  codigoProtocolo        String?         @map("codigo_protocolo")

  /// Corporaciones sugeridas (JSON array de IDs)
  corporacionesSugeridas Json            @map("corporaciones_sugeridas")

  estaActivo             Boolean         @default(true) @map("esta_activo")
  creadoEn               DateTime        @default(now()) @map("creado_en")
  actualizadoEn          DateTime        @updatedAt @map("actualizado_en")

  incidentes             Incidente[]

  @@map("tipos_incidente")
}

// ============================================
// MÓDULO: CORPORACIONES Y UNIDADES
// ============================================

/// Catálogo de corporaciones de emergencia
/// Policía, Bomberos, Cruz Roja, etc.
model Corporacion {
  id          String    @id @default(uuid())
  codigo      String    @unique
  nombre      String    @unique
  tipo        String    /// Tipo: Policía, Médica, Protección Civil, etc.
  estaActivo  Boolean   @default(true) @map("esta_activo")
  creadoEn    DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  unidades    Unidad[]
  incidentes  IncidenteCorporacion[]
  usuarios    UsuarioCorporacion[]

  @@map("corporaciones")
}

/// Catálogo de unidades de fuerza
/// Patrullas, ambulancias, unidades de bomberos, etc.
model Unidad {
  id              String      @id @default(uuid())
  numeroEconomico String      @unique @map("numero_economico")
  placas          String?
  corporacionId   String      @map("corporacion_id")
  corporacion     Corporacion @relation(fields: [corporacionId], references: [id], onDelete: Cascade)

  /// Estado de la unidad
  estado          String      @default("DISPONIBLE") /// DISPONIBLE, ASIGNADA, EN_CAMINO, EN_LUGAR, NO_DISPONIBLE
  sector          String?
  misionActualId  String?     @unique @map("mision_actual_id")

  estaActivo      Boolean     @default(true) @map("esta_activo")
  creadoEn        DateTime    @default(now()) @map("creado_en")
  actualizadoEn   DateTime    @updatedAt @map("actualizado_en")

  misiones        Mision[]
  registros       RegistroUnidad[]

  @@map("unidades")
}

// ============================================
// MÓDULO: LLAMADAS TELEFÓNICAS
// ============================================

/// Registro de llamadas entrantes
/// Almacena información ANI/ALI/CNI de cada llamada
model LlamadaTelefonica {
  id              String    @id @default(uuid())

  /// Información ANI/ALI
  numeroTelefonico String   @map("numero_telefonico")
  tipoTelefono    String?   @map("tipo_telefono") /// MÓVIL, FIJO
  compania        String?   /// TELCEL, MOVISTAR, AT&T, etc.

  /// Información CNI (Localización)
  calle           String?
  colonia         String?
  codigoPostal    String?   @map("codigo_postal")
  municipio       String?
  latitud         Float?
  longitud        Float?

  /// Estado de la llamada
  estado          String    @default("ENTRANTE") /// ENTRANTE, CONTESTADA, EN_ESPERA, TRANSFERIDA, FINALIZADA
  clasificacion   String?   /// CREAR_NUEVO, ADJUNTAR, COMPLEMENTAR, NO_PROCEDENTE

  /// Tiempos
  horaInicio      DateTime  @default(now()) @map("hora_inicio")
  horaRespuesta   DateTime? @map("hora_respuesta")
  horaFin         DateTime? @map("hora_fin")
  duracion        Int?      /// En segundos

  /// Restricciones detectadas
  tieneRestriccion Boolean  @default(false) @map("tiene_restriccion")
  tipoRestriccion String?   @map("tipo_restriccion")

  /// Relaciones
  operadorId      String?   @map("operador_id")
  operador        Usuario?  @relation("OperadorLlamada", fields: [operadorId], references: [id])
  incidenteId     String?   @map("incidente_id")
  incidente       Incidente? @relation(fields: [incidenteId], references: [id])
  restriccionId   String?   @map("restriccion_id")
  restriccion     RestriccionTelefonica? @relation(fields: [restriccionId], references: [id])

  creadoEn        DateTime  @default(now()) @map("creado_en")
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en")

  @@index([numeroTelefonico])
  @@map("llamadas_telefonicas")
}

/// Catálogo de restricciones telefónicas
/// 6 tipos: BROMA, ORDEN, CAUTELAR, PROTECCION, GEAVI, RECURRENTE
model RestriccionTelefonica {
  id              String    @id @default(uuid())
  numeroTelefonico String   @unique @map("numero_telefonico")
  tipo            String    /// BROMA, ORDEN, CAUTELAR, PROTECCION, GEAVI, RECURRENTE

  /// Datos de la persona
  nombrePersona   String?   @map("nombre_persona")
  domicilio       String?

  /// Información legal
  numeroExpediente String?  @map("numero_expediente")
  autoridadOrdena String?   @map("autoridad_ordena")
  fechaInicio     DateTime  @map("fecha_inicio")
  fechaTermino    DateTime? @map("fecha_termino")
  esIndefinida    Boolean   @default(false) @map("es_indefinida")

  observaciones   String?
  estaActivo      Boolean   @default(true) @map("esta_activo")

  creadoEn        DateTime  @default(now()) @map("creado_en")
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en")
  creadoPor       String?   @map("creado_por")

  llamadas        LlamadaTelefonica[]

  @@map("restricciones_telefonicas")
}

// ============================================
// MÓDULO: INCIDENTES
// ============================================

/// Tabla principal de incidentes
/// Almacena toda la información de eventos reportados
model Incidente {
  id              String    @id @default(uuid())
  folio           String    @unique /// Formato: EDOMEX/1/19111100072

  /// Ubicación
  municipioId     String    @map("municipio_id")
  municipio       Municipio @relation(fields: [municipioId], references: [id])
  calle           String
  esquina         String?
  coloniaId       String?   @map("colonia_id")
  colonia         Colonia?  @relation(fields: [coloniaId], references: [id])
  codigoPostal    String    @map("codigo_postal")
  puntoInteres    String?   @map("punto_interes")
  referencias     String?
  latitud         Float?
  longitud        Float?
  direccionCompleta String  @map("direccion_completa")

  /// Tipo y prioridad
  tipoIncidenteId String    @map("tipo_incidente_id")
  tipoIncidente   TipoIncidente @relation(fields: [tipoIncidenteId], references: [id])
  prioridad       String    /// CRITICA, ALTA, MEDIA, BAJA
  nivelPrioridad  Int       @default(3) @map("nivel_prioridad") /// 1=Crítica, 2=Alta, 3=Media, 4=Baja
  prioridadModificadaPor String? @map("prioridad_modificada_por")
  razonModificacionPrioridad String? @map("razon_modificacion_prioridad")

  /// Estado
  estado          String    @default("EN_CAPTURA") /// EN_CAPTURA, CANALIZADO, ASIGNADO, EN_PROCESO, CERRADO

  /// Datos del llamante
  nombreLlamante  String?   @map("nombre_llamante")
  apellidoPaternoLlamante String? @map("apellido_paterno_llamante")
  apellidoMaternoLlamante String? @map("apellido_materno_llamante")
  telefonoLlamante String?  @map("telefono_llamante")
  telefonoAlternativo String? @map("telefono_alternativo")
  relacionLlamante String?  @map("relacion_llamante") /// VICTIMA, TESTIGO, FAMILIAR, ANONIMO
  requiereSeguimiento Boolean @default(false) @map("requiere_seguimiento")
  esAnonimo       Boolean   @default(false) @map("es_anonimo")

  /// Descripción y notas
  descripcion     String?
  notas           String?

  /// Protocolo y cuestionario
  datosCuestionario Json?    @map("datos_cuestionario")
  datosProtocolo    Json?    @map("datos_protocolo")

  /// Tiempos
  creadoEn        DateTime  @default(now()) @map("creado_en")
  canalizadoEn    DateTime? @map("canalizado_en")
  cerradoEn       DateTime? @map("cerrado_en")
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en")

  /// Usuario creador
  operadorId      String    @map("operador_id")
  operador        Usuario   @relation(fields: [operadorId], references: [id])

  /// Reactivación
  estaReactivado  Boolean   @default(false) @map("esta_reactivado")
  reactivadoEn    DateTime? @map("reactivado_en")
  razonReactivacion String? @map("razon_reactivacion")

  /// Relaciones
  llamadas        LlamadaTelefonica[]
  involucrados    Involucrado[]
  corporaciones   IncidenteCorporacion[]
  misiones        Mision[]
  historial       HistorialIncidente[]

  @@index([folio])
  @@index([estado])
  @@index([creadoEn])
  @@map("incidentes")
}

/// Tabla de involucrados en incidentes
/// 7 tipos: PERSONA, VEHICULO, INMUEBLE, TELEFONO, ARMA, SUSTANCIA, DOCUMENTO
model Involucrado {
  id          String    @id @default(uuid())
  incidenteId String    @map("incidente_id")
  incidente   Incidente @relation(fields: [incidenteId], references: [id], onDelete: Cascade)

  tipo        String    /// PERSONA, VEHICULO, INMUEBLE, TELEFONO, ARMA, SUSTANCIA, DOCUMENTO

  /// Datos almacenados en JSON según el tipo
  datos       Json

  /// Para búsqueda rápida
  textoBusqueda String  @map("texto_busqueda")

  creadoEn    DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([incidenteId])
  @@index([tipo])
  @@map("involucrados")
}

/// Relación entre incidentes y corporaciones
/// Rastrea qué corporaciones fueron notificadas para cada incidente
model IncidenteCorporacion {
  id            String      @id @default(uuid())
  incidenteId   String      @map("incidente_id")
  incidente     Incidente   @relation(fields: [incidenteId], references: [id], onDelete: Cascade)
  corporacionId String      @map("corporacion_id")
  corporacion   Corporacion @relation(fields: [corporacionId], references: [id])

  estado        String      @default("PENDIENTE") /// PENDIENTE, ENVIADO, CERRADO, ERROR
  esSugerida    Boolean     @default(false) @map("es_sugerida")
  enviadoEn     DateTime?   @map("enviado_en")
  cerradoEn     DateTime?   @map("cerrado_en")

  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")

  @@unique([incidenteId, corporacionId])
  @@map("incidentes_corporaciones")
}

// ============================================
// MÓDULO: MISIONES Y DESPACHO
// ============================================

/// Tabla de misiones asignadas a unidades
/// Rastrea el ciclo completo de atención de un incidente
model Mision {
  id          String    @id @default(uuid())
  incidenteId String    @map("incidente_id")
  incidente   Incidente @relation(fields: [incidenteId], references: [id], onDelete: Cascade)
  unidadId    String    @map("unidad_id")
  unidad      Unidad    @relation(fields: [unidadId], references: [id])

  /// Etapas de la misión (NO REVERSIBLES)
  estado      String    @default("ASIGNADA") /// ASIGNADA, EN_CAMINO, EN_LUGAR, ATENDIDA, ATENDIDA_CON_DETENCION, FALSO

  /// Tiempos
  asignadoEn  DateTime  @default(now()) @map("asignado_en")
  enRutaEn    DateTime? @map("en_ruta_en")
  arriboEn    DateTime? @map("arribo_en")
  completadoEn DateTime? @map("completado_en")

  /// Información adicional
  numeroDetenidos Int?   @map("numero_detenidos")
  motivoFalso     String? @map("motivo_falso")
  notas           String?

  /// Tiempos calculados
  tiempoRespuesta Int?   @map("tiempo_respuesta") /// Minutos hasta llegar
  tiempoTotal     Int?   @map("tiempo_total") /// Minutos totales

  creadoEn    DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  historialEstados HistorialEstadoMision[]

  @@index([incidenteId])
  @@index([unidadId])
  @@index([estado])
  @@map("misiones")
}

/// Historial de cambios de estado de misiones
/// Rastrea todas las transiciones de estado
model HistorialEstadoMision {
  id          String    @id @default(uuid())
  misionId    String    @map("mision_id")
  mision      Mision    @relation(fields: [misionId], references: [id], onDelete: Cascade)

  estadoAnterior String? @map("estado_anterior")
  estadoNuevo    String  @map("estado_nuevo")
  notas          String?

  creadoEn    DateTime  @default(now()) @map("creado_en")
  creadoPor   String?   @map("creado_por")

  @@map("historial_estados_mision")
}

// ============================================
// MÓDULO: BITÁCORAS Y REGISTROS
// ============================================

/// Bitácora de eventos de unidades
/// Rastrea todos los eventos y cambios de estado de las unidades
model RegistroUnidad {
  id          String    @id @default(uuid())
  unidadId    String    @map("unidad_id")
  unidad      Unidad    @relation(fields: [unidadId], references: [id])

  evento      String    /// INICIO_TURNO, ASIGNADA, EN_CAMINO, EN_LUGAR, ATENDIDA, DISPONIBLE, NO_DISPONIBLE
  detalles    String?
  sector      String?

  creadoEn    DateTime  @default(now()) @map("creado_en")

  @@index([unidadId, creadoEn])
  @@map("registros_unidades")
}

/// Historial de cambios en incidentes
/// Rastrea todas las modificaciones realizadas
model HistorialIncidente {
  id          String    @id @default(uuid())
  incidenteId String    @map("incidente_id")
  incidente   Incidente @relation(fields: [incidenteId], references: [id], onDelete: Cascade)

  accion      String    /// CREADO, MODIFICADO, CANALIZADO, CERRADO, REACTIVADO
  campo       String?
  valorAnterior String? @map("valor_anterior")
  valorNuevo    String? @map("valor_nuevo")
  usuarioId     String? @map("usuario_id")
  nombreUsuario String? @map("nombre_usuario")

  creadoEn    DateTime  @default(now()) @map("creado_en")

  @@index([incidenteId, creadoEn])
  @@map("historial_incidentes")
}

/// Registros de auditoría del sistema
/// Rastrea TODAS las acciones críticas de los usuarios
model RegistroAuditoria {
  id          String    @id @default(uuid())
  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation("UsuarioAuditoria", fields: [usuarioId], references: [id])

  accion      String    /// LOGIN, LOGOUT, CREATE, UPDATE, DELETE, etc.
  entidad     String    /// INCIDENTE, USUARIO, UNIDAD, etc.
  entidadId   String?   @map("entidad_id")

  datosAnteriores Json? @map("datos_anteriores")
  datosNuevos     Json? @map("datos_nuevos")

  direccionIP     String? @map("direccion_ip")
  navegador       String?

  creadoEn    DateTime  @default(now()) @map("creado_en")

  @@index([usuarioId, creadoEn])
  @@index([entidad, entidadId])
  @@map("registros_auditoria")
}

// ============================================
// MÓDULO: CONTROL DE AUSENCIAS
// ============================================

/// Solicitudes de ausencia de operadores
/// Rastrea descansos, comidas, baños, etc.
model Ausencia {
  id          String    @id @default(uuid())
  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

  motivo      String    /// COMIDA, BAÑO, DESCANSO, OTRO
  estado      String    @default("PENDIENTE") /// PENDIENTE, APROBADA, RECHAZADA

  solicitadoEn DateTime @default(now()) @map("solicitado_en")
  inicioEn     DateTime? @map("inicio_en")
  finEn        DateTime? @map("fin_en")
  duracion     Int?     /// En minutos

  aprobadoPor  String?  @map("aprobado_por")
  aprobadoEn   DateTime? @map("aprobado_en")
  rechazadoEn  DateTime? @map("rechazado_en")

  notas        String?

  @@index([usuarioId, solicitadoEn])
  @@map("ausencias")
}

// ============================================
// TABLAS DE RELACIÓN (Many-to-Many)
// ============================================

/// Relación entre usuarios y municipios
/// Define qué municipios puede atender cada usuario
model UsuarioMunicipio {
  usuarioId    String   @map("usuario_id")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  municipioId  String   @map("municipio_id")
  municipio    Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)

  creadoEn     DateTime @default(now()) @map("creado_en")

  @@id([usuarioId, municipioId])
  @@map("usuarios_municipios")
}

/// Relación entre usuarios y corporaciones
/// Define qué corporaciones puede ver/gestionar cada usuario
model UsuarioCorporacion {
  usuarioId     String      @map("usuario_id")
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  corporacionId String      @map("corporacion_id")
  corporacion   Corporacion @relation(fields: [corporacionId], references: [id], onDelete: Cascade)

  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@id([usuarioId, corporacionId])
  @@map("usuarios_corporaciones")
}
